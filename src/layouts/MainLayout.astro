---
import "@/styles/globals.css";
import Navigation from "../components/common/navigation";
import Footer from "../components/common/Footer";
import { HEADER_QUERY } from "@/graphql/queries/header";
import { FOOTER_QUERY } from "@/graphql/queries/footer";

// Define the props interface
interface Props {
  title: string;
}

// Explicitly use the Props type to satisfy ESLint
const props: Props = Astro.props;
const { title } = props;

// Fetch header and footer data
let headerSectionData = null;
let footerSectionData = null;

try {
  const [headerResponse, footerResponse] = await Promise.all([
    fetch(import.meta.env.DATOCMS_ENDPOINT, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
      },
      body: JSON.stringify({ query: HEADER_QUERY }),
    }),
    fetch(import.meta.env.DATOCMS_ENDPOINT, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
      },
      body: JSON.stringify({ query: FOOTER_QUERY }),
    }),
  ]);

  const [{ data: headerData }, { data: footerData }] = await Promise.all([
    headerResponse.json(),
    footerResponse.json(),
  ]);

  // Add null checks to prevent accessing properties of undefined
  headerSectionData = headerData?.allHeaders?.[0] || null;
  footerSectionData = footerData?.allFooters?.[0] || null;
} catch (error) {
  console.error("Error fetching layout data:", error);
  // Set default values or leave as null
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="flex flex-col">
    <Navigation client:load headerData={headerSectionData} />
    <main>
      <slot />
    </main>
    <Footer client:load footerData={footerSectionData} />
  </body>
</html>
