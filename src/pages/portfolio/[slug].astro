---
import "@/styles/globals.css";
import Navigation from "@/components/common/navigation";
import Footer from "@/components/common/Footer";
import MainSection from "@/components/Portfolio/Detail/MainSection";
import {
  PORTFOLIO_BY_SLUG_QUERY,
  ALL_PORTFOLIO_SLUGS_QUERY,
} from "@/graphql/queries/portfolioDetail";
import { CONTACT_QUERY } from "@/graphql/queries/contact";

// Generate all possible paths at build time
export async function getStaticPaths() {
  const response = await fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: ALL_PORTFOLIO_SLUGS_QUERY }),
  });

  const { data } = await response.json();

  // Extract all client project slugs from all landing pages
  const paths: { params: { slug: string } }[] = [];
  data.allPortfolioLandingPages.forEach((landingPage: { clientsProject: any[] }) => {
    if (landingPage.clientsProject && landingPage.clientsProject.length > 0) {
      landingPage.clientsProject.forEach((project: { slug: string }) => {
        if (project.slug) {
          paths.push({ params: { slug: project.slug } });
        }
      });
    }
  });

  return paths;
}

// Get the slug from the URL
const { slug } = Astro.params;

// Fetch portfolio page and contact data
const [portfolioResponse, contactResponse] = await Promise.all([
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({
      query: PORTFOLIO_BY_SLUG_QUERY,
      variables: { slug: slug },
    }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: CONTACT_QUERY }),
  }),
]);

const [portfolioResult, contactResult] = await Promise.all([
  portfolioResponse.json(),
  contactResponse.json(),
]);

let portfolioPage;
if (portfolioResult && portfolioResult.data) {
  portfolioPage = portfolioResult.data.portfolioPage;
} else {
  console.error("Invalid portfolio data structure:", portfolioResult);
}

const contactSectionData = contactResult.data?.allContacts?.[0];

// Handle case where portfolio item is not found
if (!portfolioPage) {
  return Astro.redirect("/404");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{portfolioPage.title} - Portfolio | Octalogic</title>
  </head>
  <body>
    <Navigation client:load />
    <main>
      <MainSection client:load portfolioPage={portfolioPage} contactData={contactSectionData} />
    </main>
    <Footer client:load />
  </body>
</html>
