---
// eslint-disable-next-line import/no-unassigned-import
import "@/styles/globals.css";
import Navigation from "../../components/common/navigation";
import Footer from "../../components/common/Footer";
import { portfolioMainSections } from "../../data/portfolio";
import { portfolioDetails } from "../../data/portfolioDetails";
import ContactUsSection from "../../components/common/ContactUsSection";
import HeroSection from "../../components/Portfolio/Detail/PortfolioDetailsHeroSection";
import MainContent from "../../components/Portfolio/Detail/PortFolioDetailsMainContent";
import type { PortfolioDetailSection } from "@/types/portfolioDetails";

interface Props {
  detailData: PortfolioDetailSection;
}

export function getStaticPaths() {
  const paths = portfolioMainSections.map((section) => {
    const slug = section.href.split("/").pop() || "";
    console.log("Processing slug:", slug); // Debug log

    if (!portfolioDetails[slug]) {
      console.error(`Missing portfolio details for slug: ${slug}`); // Debug log
      throw new Error(`No details found for portfolio item: ${slug}`);
    }

    return {
      params: { slug },
      props: { detailData: portfolioDetails[slug] },
    };
  });

  console.log("Generated paths:", paths); // Debug log
  return paths;
}

const { detailData } = Astro.props as Props;

if (!detailData) {
  throw new Error("Portfolio data not found");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{detailData.labelText} - Portfolio</title>
  </head>
  <body>
    <Navigation client:load />
    <main>
      <HeroSection client:load section={detailData} />
      <MainContent client:load section={detailData} />
    </main>
    <ContactUsSection client:load />
    <Footer client:load />
  </body>
</html>
