---
import MainLayout from "../layouts/MainLayout.astro";
import Mainsection from "../components/Portfolio/MainSection";
import { PORTFOLIO_PAGE_QUERY } from "@/graphql/queries/portfolio";
import { CONTACT_QUERY } from "@/graphql/queries/contact";

const [portfolioResponse, contactResponse] = await Promise.all([
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({
      query: PORTFOLIO_PAGE_QUERY,
    }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: CONTACT_QUERY }),
  }),
]);

const [{ data: portfolioData }, { data: contactData }] = await Promise.all([
  portfolioResponse.json(),
  contactResponse.json(),
]);

const portfolioPageData = portfolioData?.allPortfolioLandingPages?.[0];
const contactSectionData = contactData?.allContacts?.[0];
---

<MainLayout title="Portfolio">
  <Mainsection client:load data={portfolioPageData} contactData={contactSectionData} />
</MainLayout>
