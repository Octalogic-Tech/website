---
// eslint-disable-next-line import/no-unassigned-import, prettier/prettier
import "@/styles/globals.css";
// import Navigation from "./navigation";
// import { ModeToggle } from "@/components/ModeToggle";
import "@fontsource-variable/montserrat";
import "@fontsource/barlow-condensed/100.css";
import "@fontsource/barlow-condensed/200.css";
import "@fontsource/barlow-condensed/300.css";
import "@fontsource/barlow-condensed/400.css";
import "@fontsource/barlow-condensed/500.css";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow-condensed/800.css";
import "@fontsource/barlow-condensed/900.css";

import { Typography, type VariantType, type WeightType } from "../components/ui/typography";

const montserratVariants = [
  { variant: "captionM", size: 12 },
  { variant: "captionL", size: 14 },
  { variant: "bodyM", size: 16 },
  { variant: "bodyL", size: 20 },
  { variant: "h6", size: 24 },
];

const barlowVariants = [
  { variant: "h5", size: 32 },
  { variant: "h4", size: 40 },
  { variant: "h3", size: 48 },
  { variant: "h2", size: 64 },
  { variant: "h1", size: 80 },
];

const weights = ["normal", "medium", "semibold", "bold"];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Typography1</title>
  </head>
  <body class="bg-white font-sans text-black">
    <section
      class="flex items-center justify-between rounded-t-md bg-teal-400 px-6 py-4 text-black"
    >
      <div>
        <h1 class="text-xl font-bold">Typography</h1>
        <p class="text-sm text-gray-800">Design System → Typography</p>
      </div>
      <span class="text-xs text-gray-800">Octalogic Tech design system</span>
    </section>

    <div class="overflow-x-auto">
      <table class="min-w-full table-fixed border border-gray-200 text-center">
        <thead class="bg-white">
          <tr>
            <th class="w-32 border border-gray-200 bg-white"></th>
            {
              montserratVariants.map(({ size }) => (
                <th class="border border-gray-200 py-2">{size}</th>
              ))
            }
            {barlowVariants.map(({ size }) => <th class="border border-gray-200 py-2">{size}</th>)}
          </tr>
          <tr>
            <th class="border border-gray-200 bg-white px-2 py-2 text-center">Montserrat</th>
            {montserratVariants.map(() => <th class="border border-gray-200 py-1" />)}
            <th
              colspan={barlowVariants.length}
              class="border border-gray-200 bg-white px-2 text-center">Barlow Condensed</th
            >
          </tr>
        </thead>
        <tbody>
          {
            weights.map((weight) => (
              <tr>
                <td class="border border-gray-200 px-2 py-2 text-left font-semibold capitalize">
                  {weight}
                </td>
                {montserratVariants.map(({ variant }) => (
                  <td class="border border-gray-200 py-2">
                    <Typography
                      font="montserrat"
                      variant={variant as VariantType}
                      weight={weight as WeightType}
                    >
                      Hello There
                    </Typography>
                  </td>
                ))}
                {barlowVariants.map(({ variant }) => (
                  <td class="border border-gray-200 py-2">
                    {weight === "normal" || weight === "bold" ? null : (
                      <Typography
                        font="barlow-condensed"
                        variant={variant as VariantType}
                        weight={weight as WeightType}
                      >
                        HELLO THERE
                      </Typography>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </body>
</html>
