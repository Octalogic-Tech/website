---
import "@/styles/globals.css";
import { ContactButton, InputBlock, Typography } from "../components/template";
---

<html>
  <head>
    <title>Template Page</title>
  </head>
  <body>
    <ContactButton type="primary" />
    <ContactButton type="primary_optional" />
    <ContactButton type="secondary" />
    <ContactButton type="no_stroke" />

    <InputBlock type="email" id="email" placeholder="Email" client:load />

    <Typography variant="H1SemiBold80"> Hello - H1SemiBold80 </Typography>
    <Typography variant="H2SemiBold64"> Hello - H2SemiBold64 </Typography>
    <Typography variant="H2Medium64"> Hello - H2Medium64 </Typography>
    <Typography variant="H3Medium48"> Hello - H3Medium48 </Typography>
    <Typography variant="H3SemiBold48"> Hello - H3SemiBold48 </Typography>
    <Typography variant="H4SemiBold40"> Hello - H4SemiBold40 </Typography>
    <Typography variant="H5Medium32"> Hello - H5Medium32 </Typography>
    <Typography variant="H5SemiBold32"> Hello - H5SemiBold32 </Typography>
    <Typography variant="H6Medium24"> Hello - H6Medium24 </Typography>
    <Typography variant="H6Bold24"> Hello - H6Bold24 </Typography>
    <Typography variant="BodyMRegular16"> Hello - BodyMRegular16 </Typography>
    <Typography variant="BodyMMedium16"> Hello - BodyMMedium16 </Typography>
    <Typography variant="BodyLMedium20"> Hello - BodyLMedium20 </Typography>
    <Typography variant="CaptionMMedium12"> Hello - CaptionMMedium12 </Typography>
    <Typography variant="CaptionMSemiBold12"> Hello - CaptionMSemiBold12 </Typography>
    <Typography variant="CaptionLMedium14"> Hello - CaptionLMedium14 </Typography>
  </body>
</html>
