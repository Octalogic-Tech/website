---
import MainLayout from "../layouts/MainLayout.astro";
import MainSection from "../components/Services/MainSection";
import { SERVICES_PAGE_QUERY } from "@/graphql/queries/services";
import { CONTACT_QUERY } from "@/graphql/queries/contact";

// Fetch all required data at build time
const [servicesResponse, contactResponse] = await Promise.all([
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: SERVICES_PAGE_QUERY }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: CONTACT_QUERY }),
  }),
]);

const [{ data: servicesData }, { data: contactData }] = await Promise.all([
  servicesResponse.json(),
  contactResponse.json(),
]);

const servicesPageData = servicesData?.servicesPage;
const contactSectionData = contactData?.allContacts[0];
---

<MainLayout title="Services - Octalogic">
  <MainSection client:load data={servicesPageData} contactData={contactSectionData} />
</MainLayout>
