---
import MainLayout from "../layouts/MainLayout.astro";
import Mainsection from "../components/Home/MainSection.tsx";
import { HOME_PAGE_QUERY } from "@/graphql/queries/home";
import { CONTACT_QUERY } from "@/graphql/queries/contact";
import { JOIN_US_QUERY } from "@/graphql/queries/joinUs";

// Fetch page-specific data
const [homeResponse, contactResponse, joinUsResponse] = await Promise.all([
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: HOME_PAGE_QUERY }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: CONTACT_QUERY }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: JOIN_US_QUERY }),
  }),
]);

const [{ data: homeData }, { data: contactData }, { data: joinUsData }] = await Promise.all([
  homeResponse.json(),
  contactResponse.json(),
  joinUsResponse.json(),
]);

const homePageData = homeData.allHomepages[0];
const contactSectionData = contactData.allContacts[0];
const joinUsSectionData = joinUsData.allJoinOurTeams[0];
---

<MainLayout title="Home">
  <Mainsection
    client:load
    data={homePageData}
    contactData={contactSectionData}
    joinUsData={joinUsSectionData}
  />
</MainLayout>
