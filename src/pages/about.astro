  <section
    class="relative flex flex-col items-center justify-center bg-[#DBEAFE] pb-40 text-center"
  >
    <!-- White panel with slanted sides and curved bottom -->
    <div
      class="relative mx-auto w-[92%] max-w-7xl overflow-hidden px-6 py-20 md:px-16 md:py-28"
      style="
      background: white;
      border: 1px solid;
      border-image-source: linear-gradient(180deg, #FFFFFF 0%, #0A3D62 100%);
      border-image-slice: 1;
      border-radius: 0 0 80px 80px;
      -webkit-mask-image: polygon(8% 0%, 89.75% 0%, 75.78% 92.13%, 24% 90%);
      mask-image: polygon(8% 0%, 89.75% 0%, 75.78% 92%, 24% 90%);
      mask-type: alpha;
      -webkit-mask-type: alpha;
      overflow: hidden;"
    >
      <!-- Section label -->
      <span
        class={typographyVariants({
          font: "montserrat",
          variant: "captionL",
          weight: "medium",
          className:
            "mb-6 inline-block rounded-full border border-dashed border-[#C3D2E2] px-2.5 py-1 tracking-[0.5em] text-[#0A3D62] uppercase",
        })}
      >
        {content.sectionTag}
      </span>

      <!-- Heading -->
      <h1
        class="mx-auto mb-6 max-w-3xl text-4xl leading-tight font-bold text-[#0A2239] uppercase md:text-5xl"
      >
        {content.heroTitle}
      </h1>

      <!-- Description -->
      <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-gray-600">
        {content.heroDescription}
      </p>

      <!-- Button -->
      <a
        href={content.workWithUsButton.buttonUrl}
        class="inline-block rounded-full bg-[#30E3CA] px-8 py-3 text-sm font-semibold text-[#0A3D62] uppercase transition duration-300 hover:bg-[#29cbb4] md:text-base"
      >
        {content.workWithUsButton.buttonLabel}
      </a>
    </div>
  </section>

  <section class="bg-[#DBEAFE] py-6">
    <ImageCarousel
      images={content.imageCarousel.map((img) => ({
        src: img.responsiveImage.src,
        alt: img.responsiveImage.alt,
      }))}
    />
  </section>
  <section class="bg-[#DBEAFE] py-16 text-center">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-4 text-2xl font-semibold">{content.missionTitle}</h2>
      <p class="text-base text-gray-700">{content.missionDescription}</p>
    </div>
  </section>
  <section class="bg-white py-8">
    <TestimonialCarousel testimonials={content.testimonial} />
  </section>
  <section class="w-full">
    <img
      src={content.banner.responsiveImage.src}
      srcset={content.banner.responsiveImage.srcSet}
      sizes={content.banner.responsiveImage.sizes}
      alt={content.banner.alt}
      class="h-auto w-full object-cover grayscale filter"
    />
  </section>
  <PurposeSection
    title={content.purposeTitle}
    description={content.purposeDescription}
    cards={content.purposeCards}
  />
  <IntroCall
    title="Get started with an intro call."
    button={{
      buttonLabel: "Book a Call",
      buttonUrl: "/contact",
    }}
  />
  <JoinOurTeam
    title="Join our team"
    description="Fulfilling tech-led projects for seasoned designers, developers, and product owners. Solve the problem, find the joy, measure the outcome, and be fulfilled."
    button={{
      buttonLabel: "We are hiring",
      buttonUrl: "/careers",
    }}
    image={{
      src: "/images/Contents.png",
      alt: "image",
    }}
  />
</BaseLayout>

<style>
  .hero-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .background-shape {
    clip-path: polygon(0 0, 100% 0, 100% 85%, 0% 100%);
  }

  .white-shape {
    width: 1248px;
    height: 680px;
    border: 1px solid transparent;
    border-image-source: linear-gradient(180deg, #ffffff 0%, #0a3d62 100%);
    border-image-slice: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 1280px) {
    .white-shape {
      width: calc(100% - 48px);
      max-width: 1248px;
      height: auto;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }

  @media (max-width: 768px) {
    .white-shape {
      width: calc(100% - 32px);
      padding-top: 3rem;
      padding-bottom: 3rem;
    }
  }
</style>
