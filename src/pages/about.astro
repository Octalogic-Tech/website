---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fetchDatoCMS } from "@/lib/fetcherData";
import { ABOUT_PAGE_QUERY } from "@/graphql/about";
import type { AboutPageQueryResponse } from "@/graphql/about";
import HeroSection from "@/components/sections/about/hero-section.astro";
import ImageCarousel from "@/components/sections/about/image-carousel.astro";
import MissionSection from "@/components/sections/about/mission-section.astro";
import TestimonialCarousel from "@/components/sections/about/testimonial-carousel.astro";
import PurposeSection from "@/components/sections/about/purpose-section.astro";
import IntroCall from "@/components/sections/about/intro-call.astro";
import JoinOurTeam from "@/components/sections/about/join-our-team.astro";

const title = "About Us | Octalogic Tech";

const data = await fetchDatoCMS<AboutPageQueryResponse>(ABOUT_PAGE_QUERY);
const content = data.allAboutPages[0];
---

<BaseLayout title={title}>
  <HeroSection
    sectionTag={content.sectionTag}
    heroTitle={content.heroTitle}
    heroDescription={content.heroDescription}
    workWithUsButton={content.workWithUsButton}
  />
  <ImageCarousel
    images={content.imageCarousel.map((img) => ({
      src: img.responsiveImage.src,
      alt: img.responsiveImage.alt,
    }))}
  />
  <MissionSection title={content.missionTitle} description={content.missionDescription} />
  <TestimonialCarousel testimonials={content.testimonial} />
  <section class="w-full">
    <img
      src={content.banner.responsiveImage.src}
      srcset={content.banner.responsiveImage.srcSet}
      sizes={content.banner.responsiveImage.sizes}
      alt={content.banner.alt}
      class="h-auto w-full object-cover grayscale filter"
    />
  </section>
  <PurposeSection
    title={content.purposeTitle}
    description={content.purposeDescription}
    cards={content.purposeCards}
  />
  <IntroCall
    title="Get started with an intro call."
    button={{
      buttonLabel: "Book a Call",
      buttonUrl: "/contact",
    }}
  />
  <JoinOurTeam
    title="Join our team"
    description="Fulfilling tech-led projects for seasoned designers, developers, and product owners. Solve the problem, find the joy, measure the outcome, and be fulfilled."
    button={{
      buttonLabel: "We are hiring",
      buttonUrl: "/careers",
    }}
    image={{
      src: "/images/Contents.png",
      alt: "image",
    }}
  />
</BaseLayout>

<style>
  .hero-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }
</style>
