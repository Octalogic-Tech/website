---
import MainLayout from "../layouts/MainLayout.astro";
import Mainsection from "../components/About/MainSection.tsx";
import { ABOUT_PAGE_QUERY } from "@/graphql/queries/about";
import { CONTACT_QUERY } from "@/graphql/queries/contact";
import { JOIN_US_QUERY } from "@/graphql/queries/joinUs";

// Fetch all required data at build time
const [aboutResponse, contactResponse, joinUsResponse] = await Promise.all([
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: ABOUT_PAGE_QUERY }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: CONTACT_QUERY }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: JOIN_US_QUERY }),
  }),
]);

const [{ data: aboutData }, { data: contactData }, { data: joinUsData }] = await Promise.all([
  aboutResponse.json(),
  contactResponse.json(),
  joinUsResponse.json(),
]);

const aboutPageData = aboutData.allAboutPages[0];
const contactSectionData = contactData.allContacts[0];
const joinUsSectionData = joinUsData.allJoinOurTeams[0];
---

<MainLayout title="About Us">
  <Mainsection
    client:load
    data={aboutPageData}
    contactData={contactSectionData}
    joinUsData={joinUsSectionData}
  />
</MainLayout>
