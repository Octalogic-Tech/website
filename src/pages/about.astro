---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fetchDatoCMS } from "@/lib/fetcherData";
import { ABOUT_PAGE_QUERY, type AboutPageQueryResponse } from "@/graphql/about";
import HeroSection from "@/components/sections/about/HeroSection.astro";
import HeroImageCarousel from "@/components/sections/about/HeroImageCarousel.astro";
import Mission from "@/components/sections/about/Mission.astro";
import Testimonials from "@/components/sections/about/Testimonials.astro";
import TeamPhoto from "@/components/sections/about/TeamPhoto.astro";
import Purpose from "@/components/sections/about/Purpose.astro";
import Intro from "@/components/sections/about/Intro.astro";
import JoinOurTeam from "@/components/sections/about/JoinOurTeam.astro";

const title = "About Us | Octalogic Tech";

const data = await fetchDatoCMS<AboutPageQueryResponse>(ABOUT_PAGE_QUERY);
const content = data.allAboutPages[0];
---

<BaseLayout title={title}>
  <HeroSection
    sectionTag={content.sectionTag}
    heroTitle={content.heroTitle}
    heroDescription={content.heroDescription}
    workWithUsButton={content.workWithUsButton}
  />
  <HeroImageCarousel images={content.imageCarousel} />
  <Mission missionTitle={content.missionTitle} missionDescription={content.missionDescription} />
  <Testimonials testimonials={content.testimonial} />
  <TeamPhoto banner={content.banner} />
  <Purpose
    title={content.purposeTitle}
    description={content.purposeDescription}
    cards={content.purposeCards}
  />

  <Intro title="Get started with an intro call" workWithUsButton={content.workWithUsButton} />

  <JoinOurTeam
    title={content?.missionTitle}
    description={content?.missionDescription}
    workWithUsButton={content.workWithUsButton}
    banner={content.banner}
  />
</BaseLayout>

<style>
  .hero-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }
</style>
