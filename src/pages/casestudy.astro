---
import MainLayout from "../layouts/MainLayout.astro";
import MainSection from "../components/CaseStudy/Mainsection";
import { CASE_STUDY_PAGE_QUERY } from "@/graphql/queries/caseStudy";
import { CONTACT_QUERY } from "@/graphql/queries/contact";

// Fetch all required data at build time
const [caseStudyResponse, contactResponse] = await Promise.all([
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: CASE_STUDY_PAGE_QUERY }),
  }),
  fetch(import.meta.env.DATOCMS_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${import.meta.env.DATOCMS_API_TOKEN}`,
    },
    body: JSON.stringify({ query: CONTACT_QUERY }),
  }),
]);

const [{ data: caseStudyData }, { data: contactData }] = await Promise.all([
  caseStudyResponse.json(),
  contactResponse.json(),
]);

const caseStudyPageData = caseStudyData.caseStudyLandingPage;
const contactSectionData = contactData.allContacts[0];
---

<MainLayout title="Case Studies - Octalogic">
  <MainSection client:load data={caseStudyPageData} contactData={contactSectionData} />
</MainLayout>
