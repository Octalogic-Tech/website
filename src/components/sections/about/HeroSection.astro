---
import { typographyVariants } from "@/components/ui/typography";
import { buttonVariants } from "@/components/ui/button";

import type { WorkWithUsButton } from "@/graphql/about";

interface Props {
  sectionTag: string;
  heroTitle: string;
  heroDescription: string;
  workWithUsButton: WorkWithUsButton;
}

const { sectionTag, heroTitle, heroDescription, workWithUsButton } = Astro.props;
---

<section
  class="bg-primary-blue-100 flex h-[calc(90vh-4.5rem)] items-center justify-center bg-[url('/src/assets/images/about/bottom_rounded_trapezoid_mob.png')] bg-cover bg-center bg-no-repeat md:h-[calc(75vh-4.5rem)] md:bg-[url('/src/assets/images/about/bottom_rounded_trapezoid.png')] xl:h-[calc(90vh-4.5rem)]"
>
  <div
    class="mx-auto flex w-full max-w-[70%] flex-col items-center justify-center gap-y-6 md:max-w-[55%] xl:max-w-[50%] xl:gap-y-12"
  >
    <!-- Section Tag -->
    <span
      class={typographyVariants({
        variant: "captionM",
        weight: "medium",
        className: `
          rounded-full border border-dashed border-gray-400 px-4 py-1.5 tracking-[0.5em] 
          text-primary-blue uppercase text-center inline-block
          xl:captionL
        `,
      })}
    >
      {sectionTag}
    </span>

    <!-- Hero Title -->
    <h1
      class={typographyVariants({
        font: "barlow-condensed",
        variant: "h3",
        weight: "semibold",
        className: `
          bg-gradient-to-r from-gray-950 to-primary-blue bg-clip-text text-center text-transparent uppercase
          xl:h1
        `,
      })}
    >
      {heroTitle}
    </h1>

    <!-- Hero Description -->
    <p
      class={typographyVariants({
        variant: "captionL",
        weight: "medium",
        className: `
          text-gray-600 text-center max-w-[85%]
          xl:bodyL xl:max-w-[80%]
        `,
      })}
    >
      {heroDescription}
    </p>

    <!-- CTA Button -->
    <a href={workWithUsButton.buttonUrl}>
      <button class={buttonVariants({ variant: "primary" })}>
        {workWithUsButton.buttonLabel}
      </button>
    </a>
  </div>
</section>
