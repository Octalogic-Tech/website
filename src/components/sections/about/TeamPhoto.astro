---
import { Image } from "@datocms/astro";

import type { ImageWithResponsive } from "@/graphql/about";

// eslint-disable-next-line @typescript-eslint/no-unused-vars
interface Props {
  banner: ImageWithResponsive;
}

const { banner } = Astro.props as Props;
---

<section class="w-full">
  <Image
    data={banner.responsiveImage}
    imgClass="h-auto w-full object-cover grayscale filter max-w-none"
    imgStyle={{
      maxWidth: "none",
    }}
  />
</section>
