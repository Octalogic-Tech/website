---
interface Props {
  title: string;
  button: {
    buttonLabel: string;
    buttonUrl: string;
  };
}

const { title, button } = Astro.props;
---

<body class="m-0 bg-[#F5F5F5]">
  <section class="flex justify-center px-4 py-10">
    <div
      class="flex h-auto w-full max-w-[1248px] flex-col items-center justify-between gap-6 rounded-[16px] border border-gray-200 bg-white px-6 py-6 shadow-[0_4px_15px_rgba(0,0,0,0.08)] md:h-[116px] md:flex-row md:gap-0 md:px-12 md:py-0"
    >
      <!-- Left Side -->
      <div class="flex items-center gap-[40px] md:h-[48px] md:max-w-[746.5px]">
        <!-- Green dot: hidden on mobile -->
        <div class="relative hidden h-6 w-6 items-center justify-center md:flex">
          <span class="absolute h-6 w-6 rounded-full bg-[#BBF7D0] opacity-60"></span>
          <span class="relative h-3 w-3 rounded-full bg-[#22C55E]"></span>
        </div>

        <!-- Title -->
        <h2
          class="text-center font-['Barlow_Condensed'] text-[28px] leading-[36px] font-semibold tracking-[-0.01em] text-[#062236] uppercase md:text-left md:text-[40px] md:leading-[48px]"
        >
          {title}
        </h2>
      </div>

      <!-- Button -->
      <a
        href={button.buttonUrl}
        class="flex min-h-[52px] w-full items-center justify-center rounded-full bg-[#82E6C8] px-6 py-3 font-['Barlow_Condensed'] text-[18px] leading-[26px] font-semibold text-[#0A3D62] uppercase md:w-auto md:text-[20px] md:leading-[28px]"
      >
        {button.buttonLabel}
      </a>
    </div>
  </section>
</body>
