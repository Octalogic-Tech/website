---
import { buttonVariants, typographyVariants } from "@/components/ui";
import type { WorkWithUsButton } from "@/graphql/about";

interface Props {
  title: string;
  workWithUsButton: WorkWithUsButton;
}

const { title, workWithUsButton } = Astro.props as Props;
---

<section class="bg-gray-200 px-4 py-20 lg:px-24 lg:py-[8.75rem]">
  <div
    class="flex flex-col items-center justify-center gap-5 rounded-2xl bg-white p-6 lg:flex-row lg:justify-between lg:gap-0 lg:p-8"
  >
    <h2
      class={typographyVariants({
        font: "barlow-condensed",
        variant: "h5",
        weight: "semibold",
        className: `text-center lg:text-left text-primary-blue uppercase
          lg:h4
        `,
      })}
    >
      {title}
    </h2>
    <a href={workWithUsButton.buttonUrl}>
      <button class={buttonVariants({ variant: "primary" })}>
        {workWithUsButton.buttonLabel}
      </button>
    </a>
  </div>
</section>
