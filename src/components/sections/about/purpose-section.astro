---
import type { PurposeCard } from "@/graphql/about";

interface Props {
  title: string;
  description: string;
  cards: PurposeCard[];
}

const { title, description, cards } = Astro.props as Props;
---

<section class="w-full bg-black text-white">
  <div
    class="mx-auto flex min-h-[1160px] max-w-[1440px] flex-col px-6 py-16 md:min-h-[1160px] md:flex-row md:gap-[64px] md:px-[96px] md:py-[140px]"
  >
    <!-- Left Column: Header -->
    <div class="flex-1 text-left">
      <h2
        class="font-barlow bg-gradient-to-r from-white to-[#8F8F8F] bg-clip-text text-[32px] leading-[40px] font-semibold tracking-[-0.02em] text-transparent uppercase sm:text-[48px] sm:leading-[56px] md:text-[64px] md:leading-[72px]"
      >
        {title}
      </h2>
      <p
        class="font-montserrat mt-4 max-w-full text-[14px] leading-[20px] font-medium text-[#D6D6D6] sm:text-[16px] sm:leading-[24px] md:mt-[24px] md:max-w-[600px]"
      >
        {description}
      </p>
    </div>

    <!-- Right Column: Cards -->
    <div class="mt-10 flex flex-1 flex-col items-center gap-6 md:mt-0 md:items-end md:gap-[16px]">
      {
        cards.map((card, idx) => (
          <div
            class={`flex w-full max-w-[360px] flex-col gap-[16px] rounded-[16px] p-6 sm:h-[272px] sm:max-w-[440px] sm:rounded-[24px] sm:p-[40px] ${
              idx === 0
                ? "bg-teal-400 text-[#0A3D62]"
                : idx === 1
                  ? "bg-blue-950 text-[#60E3CF]"
                  : "bg-white text-[#0A3D62]"
            }`}
          >
            <div class="flex flex-col items-start gap-4">
              <img
                src={card.customLogo.responsiveImage.src}
                alt={card.customLogo.alt}
                class="h-12 w-12 rounded-full border-2 object-contain sm:h-16 sm:w-16"
              />
              <h3 class="font-barlow text-[28px] leading-[36px] font-medium tracking-[-0.02em] uppercase sm:text-[36px] sm:leading-[44px] md:text-[48px] md:leading-[56px]">
                {card.title}
              </h3>
            </div>
            <p class="font-montserrat text-[14px] leading-[20px] font-medium sm:text-[14px] sm:leading-[20px]">
              {card.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
