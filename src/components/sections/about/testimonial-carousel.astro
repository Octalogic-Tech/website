---
import { typographyVariants } from "@/components/ui/typography";
import type { Testimonial } from "@/graphql/about";
import { Image as DatoImage } from "react-datocms";

interface Props {
  testimonials: Testimonial[];
}

const { testimonials }: Props = Astro.props;
---

<section class="relative bg-white py-8 sm:py-12 md:py-16">
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 md:px-8">
    <div
      class="scrollbar-hide flex h-auto gap-4 overflow-x-auto px-2 sm:gap-6 sm:px-4 md:h-[479px] md:gap-[24px] md:px-[96px]"
    >
      {
        testimonials.map((item: Testimonial) => (
          <div
            class={typographyVariants({
              variant: "bodyM",
              weight: "medium",
              className: `flex h-[380px] w-[250px] flex-shrink-0 flex-col justify-between rounded-xl border border-gray-400 bg-white p-4 sm:h-[440px] sm:w-[300px] sm:p-5 md:h-[479px] md:w-[400px] md:p-6`,
            })}
          >
            <div class="mb-2 flex justify-end">
              <DatoImage
                data={item.cardLogo.responsiveImage}
                className="w-10 h-10 sm:w-12 sm:h-12 md:w-16 md:h-16 object-contain"
              />
            </div>

            <p
              class={typographyVariants({
                font: "montserrat",
                variant: "bodyM",
                weight: "normal",
                className:
                  "mb-3 align-middle leading-[20px] tracking-[0] text-[#292929] sm:mb-4 sm:leading-[22px] md:mb-6 md:leading-[24px]",
              })}
            >
              {item.cardDescription}
            </p>

            <div class="flex h-[44px] w-[220px] items-center gap-2 sm:h-[48px] sm:w-[260px] sm:gap-3 md:h-[56px] md:w-[352px] md:gap-4">
              <DatoImage
                data={item.profileImage.responsiveImage}
                className="w-[40px] h-[40px] sm:w-[48px] sm:h-[48px] md:w-[56px] md:h-[56px] rounded-full object-cover"
              />
              <div class="flex h-[38px] min-w-0 flex-col gap-1 sm:h-[42px] md:h-[48px]">
                <p
                  class={typographyVariants({
                    font: "montserrat",
                    variant: "bodyM",
                    weight: "semibold",
                    className:
                      "align-middle leading-[20px] tracking-[0] text-[#0A3D62] sm:leading-[22px] md:leading-[24px]",
                  })}
                >
                  {item.profileName}
                </p>
                <p
                  class={typographyVariants({
                    font: "montserrat",
                    variant: "captionM",
                    weight: "medium",
                    className:
                      "align-middle leading-[16px] tracking-[0] text-[#737373] sm:leading-[18px] md:leading-[20px]",
                  })}
                >
                  {item.profilePosition}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
