---
interface Props {
  title: string;
  description: string;
  button: {
    buttonLabel: string;
    buttonUrl: string;
  };
  image?: {
    src: string;
    alt: string;
  };
}

const { title, description, button, image } = Astro.props;
---

<section class="mt-16 bg-[#141414] px-6 py-20 md:px-12">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
    <!-- Text Block -->
    <div>
      <h2 class="mb-4 text-3xl font-bold text-white uppercase md:text-4xl">
        {title}
      </h2>
      <p class="mb-6 text-base text-[#D6D6D6]">
        {description}
      </p>
      <a
        href={button.buttonUrl}
        class="inline-block rounded-full bg-[#00B669] px-6 py-3 text-sm font-semibold text-white uppercase transition duration-300 hover:bg-[#009B57] md:px-8 md:text-base"
      >
        {button.buttonLabel}
      </a>
    </div>

    {
      image && (
        <div class="overflow-hidden rounded-3xl shadow-xl">
          <img src={image.src} alt={image.alt} class="h-auto w-full object-cover" />
        </div>
      )
    }
  </div>
</section>
